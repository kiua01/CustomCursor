<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0D"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Custom Cursor"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Trackpad · color · X attack · Mojo-style"
            android:textColor="#AEAEB2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="#1C1C1E"
            android:textColor="#64D2FF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/howToText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="#1C1C1E"
            android:textColor="#E5E5EA"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <FrameLayout
            android:id="@+id/previewArea"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="16dp"
            android:background="#2C2C2E">

            <com.kiua01.customcursor.CursorView
                android:id="@+id/previewCursor"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_margin="8dp"
                android:text="Drag here to preview"
                android:textColor="#8E8E93"
                android:textSize="12sp" />
        </FrameLayout>

        <TextView android:id="@+id/modeValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="#FFF" android:text="Mode" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnModeTrackpad" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Trackpad" android:textSize="12sp" />
            <Button android:id="@+id/btnModeFullscreen" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Finger" android:textSize="12sp" />
            <Button android:id="@+id/btnModeMouse" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Mouse" android:textSize="12sp" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="#FFF" android:text="Cursor color" />
        <LinearLayout
            android:id="@+id/colorRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView android:id="@+id/trackpadPosValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="#FFF" android:text="Trackpad position" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#8E8E93" android:textSize="12sp" android:text="X offset from right edge" />
        <SeekBar android:id="@+id/seekTrackpadX" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="600" android:min="0" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#8E8E93" android:textSize="12sp" android:text="Y offset from bottom edge" />
        <SeekBar android:id="@+id/seekTrackpadY" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="600" android:min="0" />

        <Button android:id="@+id/btnAttackToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="X attack button: ON" />

        <TextView android:id="@+id/scaleValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="#FFF" android:text="Scale" />
        <SeekBar android:id="@+id/seekScale" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="400" android:min="25" />

        <TextView android:id="@+id/sizeValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#FFF" android:text="Size" />
        <SeekBar android:id="@+id/seekSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="256" android:min="16" />

        <TextView android:id="@+id/speedValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#FFF" android:text="Speed" />
        <SeekBar android:id="@+id/seekSpeed" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="1200" android:min="10" />

        <TextView android:id="@+id/opacityValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#FFF" android:text="Opacity" />
        <SeekBar android:id="@+id/seekOpacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:min="10" />

        <TextView android:id="@+id/smoothValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#FFF" android:text="Smoothing" />
        <SeekBar android:id="@+id/seekSmooth" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="95" android:min="0" />

        <Button android:id="@+id/btnPickPng" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Choose custom PNG cursor" />
        <Button android:id="@+id/btnResetPng" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reset to default arrow" />

        <Button android:id="@+id/btnAccessibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Enable Accessibility (required)" />
        <Button android:id="@+id/btnOverlayPermission" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Overlay permission (fallback)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btnStart" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Start / refresh" />
            <Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Stop overlay" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
